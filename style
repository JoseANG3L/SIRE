/* ConfiguraciÃ³n para un contenedor especÃ­fico con clase .scroll-thin */
.scroll-thin {
  height: 200px;
  overflow-y: auto;
  /* IMPORTANTE: Eliminamos 'thin' y usamos valores especÃ­ficos para navegadores modernos */
  scrollbar-width: auto; 
  scrollbar-color: #adb5bd transparent;
}

/* Chrome, Edge y Safari (.scroll-thin) */
.scroll-thin::-webkit-scrollbar {
  width: 2px !important;  /* Reducido a 2px para que sea ultra delgada */
  height: 2px !important; /* Para scroll horizontal */
}

.scroll-thin::-webkit-scrollbar-track {
  background: transparent;
}

.scroll-thin::-webkit-scrollbar-thumb {
  background: #adb5bd;
  border-radius: 10px;
}

.scroll-thin::-webkit-scrollbar-thumb:hover {
  background: #6c757d;
}


